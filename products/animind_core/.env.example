# animind_core env (copy to your shell / process manager; never commit real values).
CORE_API_KEY=change-me                 # Bearer key the app sends (ANIMIND_CORE_KEY on the app side)
GEMINI_API_KEY=                        # Gemini image + text; empty = mock art
ANIMIND_DATA_DIR=/tmp/animind-data     # puppets, jobs, persona indexes
RHUBARB_PATH=                          # optional Rhubarb Lip Sync binary for visemes

# Gemini cost cap per character. A full rig = side + front + mouth shots (~US$0.039 each).
# The engine defaults only fit the base image; ~US$0.15 fits side + front + open mouth
# (the round mouth falls back to a warped one). Set per deployment, not as a code default.
REEL_REEL_BUDGET_USD=0.15
MAX_GOOGLE_COST_PER_RUN_USD=0.15
GOOGLE_COST_ALLOW_ABOVE_CEILING=1
