# Copy to .env and fill in. Never commit .env.
# .env.example lists names only. Leave secrets empty.

# LLM providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Media
ELEVENLABS_API_KEY=
IMGBB_API_KEY=

# Factory media root. On the owner machine this is the Google Drive folder.
# models_avatar writes images under {OUTPUT_PATH}/models_avatar/<avatar>/<date>/<preset>/
OUTPUT_PATH=

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# Pinterest
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ComfyUI / RunPod. Avatar jobs reuse these. They do not change REMOTE_GPU_MODE.
REMOTE_GPU_BASE_URL=
COMFYUI_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_URL=

# AI-model avatars (models_avatar). Default backend is the live ComfyUI pod.
# CIVITAI_API_TOKEN is required only for download-models. Never commit a real token.
CIVITAI_API_TOKEN=
MODELS_AVATAR_BACKEND=runpod_pod
MODELS_AVATAR_POD_URL=
MODELS_AVATAR_MIN_INTERVAL_S=1.0
# Optional. Defaults to {OUTPUT_PATH}/models_avatar/_models
MODELS_AVATAR_MODELS_DIR=
