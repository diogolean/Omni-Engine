# Copy to .env and fill in. Never commit .env.
# .env.example lists names only. Leave secrets empty.

# LLM providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Media
ELEVENLABS_API_KEY=
IMGBB_API_KEY=

# Factory media root. On the owner machine this is the Google Drive folder.
# models_avatar writes images under {OUTPUT_PATH}/models_avatar/<avatar>/<date>/<preset>/
OUTPUT_PATH=

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# Pinterest — legacy single token. Still used by
# `python agents/posting/pinterest_main.py --channel ...` when that channel
# has no .env of its own.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_BOARD_NAME=
PINTEREST_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Per-branding Pinterest accounts (config/brandings.yaml). The scheduler
# publishes only where that file has active: true. Empty suffixed vars fall
# back to the channel .env, then to the legacy pair above.
# Drip interval for the scheduler container. Replaces the PowerShell loop.
MIN_INTERVAL_HOURS=3
MAX_INTERVAL_HOURS=6
PINTEREST_PINS_PER_RUN=1
# Calendar day for the PINTEREST_PINS_PER_DAY cap. IANA name.
PINTEREST_DAY_TZ=America/Sao_Paulo

PINTEREST_ACCESS_TOKEN_ANCIENT_KNOWLEDGE=
PINTEREST_BOARD_ID_ANCIENT_KNOWLEDGE=
PINTEREST_BOARD_NAME_ANCIENT_KNOWLEDGE=
PINTEREST_REFRESH_TOKEN_ANCIENT_KNOWLEDGE=

PINTEREST_ACCESS_TOKEN_ANNA_PROTOCOL=
PINTEREST_BOARD_ID_ANNA_PROTOCOL=
PINTEREST_BOARD_NAME_ANNA_PROTOCOL=
PINTEREST_REFRESH_TOKEN_ANNA_PROTOCOL=

# Written on the VM by GitHub Actions. Local default is `latest`.
OMNI_IMAGE_TAG=latest

# ComfyUI / RunPod. Avatar jobs reuse these. They do not change REMOTE_GPU_MODE.
REMOTE_GPU_BASE_URL=
COMFYUI_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_URL=

# AI-model avatars (models_avatar). Default backend is the live ComfyUI pod.
# CIVITAI_API_TOKEN is required only for download-models. Never commit a real token.
CIVITAI_API_TOKEN=
MODELS_AVATAR_BACKEND=runpod_pod
MODELS_AVATAR_POD_URL=
MODELS_AVATAR_MIN_INTERVAL_S=1.0
# Optional. Defaults to {OUTPUT_PATH}/models_avatar/_models
MODELS_AVATAR_MODELS_DIR=

# Supermemory (self-hosted, API v3). Any host. Empty key falls back to
# .supermemory/api-key when that file exists. Do not commit the key.
# VM compose sets the URL to http://supermemory:6767. A workstation uses
# http://localhost:6767 or an SSH tunnel.
SUPERMEMORY_BASE_URL=
SUPERMEMORY_API_KEY=
# SUPERMEMORY_REQUIRED=1 refuses production while the service is offline.
# SUPERMEMORY_AUTOSTART_WSL=1 is Windows-only and optional.
# SUPERMEMORY_DISABLED=1 keeps the process on the local ledger.

# Momma Circle Facebook page. No defaults. The connection test skips without these.
FB_MOMMA_CIRCLE_PAGE_ID=
FB_MOMMA_CIRCLE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v25.0

# Machine paths. All optional; unset keeps today's defaults.
# Root of the Drive tree (the "@ NETWORK" folder). Default: the owner's G: Drive path.
OMNI_DRIVE_ROOT=
# Last-resort reference avatar when REFERENCE_IMAGE_PATH and the page avatar are missing.
REFERENCE_AVATAR_PATH=
# ffmpeg executable tried before PATH / imageio_ffmpeg.
FFMPEG_BINARY=
# Extra font folders (os.pathsep-separated) searched by shared.paths.find_font().
FONT_DIRS=
# Skip the shared.paths .env load. Other entrypoints that call load_dotenv themselves are unchanged.
OMNI_SKIP_DOTENV=
